#!/usr/bin/perl

use strict;
use warnings;

use Sampling qw( halton_sequence );

#
# Unit test: Sampling::halton_sequence.
# Example: ./halton_sequence 1,2;3,4 5
#

my ( $ranges, $count ) = @ARGV;

my @ranges = ();
for my $range ( split /;/, $ranges ) {
    my ( $start, $end ) = split /,/, $range;
    push @ranges, [ $start, $end ];
}

my $sequence = halton_sequence( \@ranges, $count );

print join( ' ', map { join( ',', @{ $_ } ) } @{ $sequence } ), "\n";
