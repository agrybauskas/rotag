        #         if( $include_hetatoms && $label_seq_id eq '.' ) {
        #             my ( $site_id ) =
        #                 grep { $_ ne '.' }
        #                 reverse
        #                 map { $rotamer_angle->{$id}{$_} }
        #                 grep { exists $rotamer_angle->{$id}{$_} }
        #                     ( 'site_1_id', 'site_2_id', 'site_3_id', 'site_4_id' );
