        #                                             {$rotamer_id};

        #             next if ! defined $bond_parameter_atom_ids_tbl;

        #             # TODO: think about situations where there are defined
        #             # bond parameters that do not include all the atoms.
        #             for my $bond_parameter_name ( sort keys %{ $bond_parameter_atom_ids_tbl } ) {
        #                 my $origin_atom_ids_key =
