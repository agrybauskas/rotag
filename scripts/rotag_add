        #     if( exists $related_unique_residue_keys{$residue_unique_key} ) {
        #         for my $related_unique_residue_key (
        #             keys %{ $related_unique_residue_keys{$residue_unique_key} } ) {
        #             $related_residue_unique_keys{$related_unique_residue_key} = 1;

        #             next if ! exists $related_unique_residue_keys{$related_unique_residue_key};

        #             for my $reverse_unique_residue_key (
