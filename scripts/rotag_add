        #                 $related_residue_unique_keys{$reverse_unique_residue_key} = 1;
        #             }
        #         }
        #     }

        #     # TODO: refactoring is needed.
        #     if( ! exists $rotamer_angles{$residue_unique_key} &&
        #         $target_atom_site->{$atom_id}{'group_PDB'} eq 'HETATM'  ) {
        #         delete $target_atom_site->{$atom_id};
        #     }

        #     next if ! exists $rotamer_angles{$residue_unique_key};

        #     for my $rotamer_id ( sort { $a <=> $b }
        #                          keys %{ $rotamer_angles{$residue_unique_key} } ) {
        #         my $rotamer_angles =
        #             $rotamer_angles{$residue_unique_key}{$rotamer_id};

        #         # Adds missing rotamer angles.
        #         my %include_rotamers = ();
        #         for my $related_unique_residue_key ( sort keys %related_residue_unique_keys ) {
        #             # TODO: refactoring is needed as the naming convention is
        #             # very similar to other variables.
        #             my $bond_parameter_atom_ids_tbl =
