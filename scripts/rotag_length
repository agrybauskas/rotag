#!/usr/bin/perl

use strict;
use warnings;

use autodie;
use File::Basename;
use Getopt::Long;
use List::MoreUtils qw( uniq );
use Try::Tiny;

use BondParameters qw( collect_bond_lengths
                       stretchable_bonds );
use ConnectAtoms qw( assign_hetatoms
                     connect_atoms );
use ForceField::Parameters;
use Logging qw( error
                warning );
use Measure qw( bond_length );
use PDBxParser qw( determine_ligand_sites
                   filter
                   mark_selection
                   obtain_pdbx_data
                   raw2indexed
                   to_csv
                   to_pdbx );
use Version qw( $VERSION );

Getopt::Long::Configure qw( gnu_getopt );

our $VERSION = $VERSION;

#*rotag_length [options] [--] <cif-file>...
#*    calculate distance between selected atoms or bonds in residues.
#*
#*Usage:
#*    rotag_length -S input.cif > output.cif
#*
#*Options:
#*    -S, --side-chains
#*                        calculates bond lengths between the side-chain atoms.
#*    -M, --main-chains
#*                        calculates bond lengths between the main-chain atom
#*    -H, --hetero-atoms
#*                        calculates pseudo bond lengths for heteroatoms.
#*    -F, --format <format>
#*                        output format (default: pdbx | csv).
#*    -v, --version
#*                        print version.

# --------------------------------- Options ----------------------------------- #

my $calc_sidechain = 0;
my $calc_mainchain = 0;
my $calc_hetatoms = 0;
my $output_format = 'pdbx';

local $SIG{__WARN__} = sub {
    warning( { 'program' => $0,
               'message' => @_,
               'filename' => join( ', ', @ARGV ) } );
};

local $SIG{__DIE__} = sub {
    error( { 'program' => $0,
             'message' => @_,
             'filename' => join( ', ', @ARGV ) } );
};

GetOptions(
    'side-chains|S' => sub { $calc_sidechain = 1 },
    'main-chains|M' => sub { $calc_mainchain = 1 },
    'hetero-atoms|H' => sub { $calc_hetatoms = 1 },
    'format|F=s' => \$output_format,
    'help|h' => sub {
                        open my $fh, '<', $0;
                        while( <$fh> ) {
                            my ( $help_message ) = $_ =~ m/^#(\*.*)/;
                            if( $help_message ) {
                                $help_message =~ s/^\*$/ /smgx;
                                $help_message =~ s/^\*//smgx;
                                print $help_message, "\n";
                            }
                        }
                        close $fh;
                        exit;
                    },
    'version|v' => sub { print $VERSION, "\n"; exit; }
) or error( { 'program' => $0,
              'message' => "mistake in command line argument.\n" } );

# ----------------------------------- Main ------------------------------------ #

local @ARGV = ( q{-} ) unless @ARGV;

my $parameters = Parameters->new();
my $pi = $parameters->{'_[local]_constants'}{'pi'};
my $sig_figs_min = $parameters->{'_[local]_constants'}{'sig_figs_min'};
my $sig_figs_max = $parameters->{'_[local]_constants'}{'sig_figs_max'};

for my $pdbx_file ( @ARGV ) {
    my $pdbx = obtain_pdbx_data( $pdbx_file, [ '_atom_site', '_struct_conn' ] );
    raw2indexed( $pdbx, { 'attributes' => { '_atom_site' => [ 'id' ],
                                            '_struct_conn' => [ 'id' ], } } );

    my $atom_site = $pdbx->{'_atom_site'}{'data'};
    my $struct_conn = $pdbx->{'_struct_conn'}{'data'};

    if( ! defined $atom_site ) {
        warning( { 'program' => $0,
                   'message' => "no atom sites were detected.\n" } );
        next;
    }

    determine_ligand_sites( $atom_site, $struct_conn );

    # Calculates distance between side-chain bonds.
    if( $calc_sidechain ) {
        $pdbx->{'_[local]_bond_length'}{'metadata'}{'attributes'} =
            [ 'id', 'label_comp_id', 'label_seq_id', 'label_asym_id',
              'pdbx_PDB_model_num', 'label_alt_id', 'atom_1_id',
              'label_atom_1_id', 'site_1_id', 'atom_2_id', 'label_atom_2_id',
              'site_2_id', 'type', 'value' ];
        $pdbx->{'_[local]_bond_length'}{'metadata'}{'is_loop'} = 1;
        $pdbx->{'_[local]_bond_length'}{'metadata'}{'type'} = 'record';

        my $bond_length_site =
            filter( { 'atom_site' => $atom_site,
                      'include' => { '[local]_selection_state' => [ 'T', 'S' ] } } );
        my $target_bond_length_site =
            filter( { 'atom_site' => $bond_length_site,
                      'include' => { '[local]_selection_state' => [ 'T' ] } } );

        # Selects all atoms if no specific atoms are selected.
        if( ! %{ $bond_length_site } ) {
            $bond_length_site = $atom_site;
            $target_bond_length_site = $atom_site;
            mark_selection( $bond_length_site,
                            { 'target' => [ keys %{ $bond_length_site } ] } );
        }

        connect_atoms( $parameters, $bond_length_site );

        # Heteroatom assignment increases the atom number in the atom site.
        if( $calc_hetatoms ) {
            assign_hetatoms( $parameters, $bond_length_site, $struct_conn );

            # Updating the target's atom site as there more duplicated pseudo
            # atoms.
            for my $atom_id ( keys %{ $bond_length_site } ) {
                my $origin_atom_id =
                    $bond_length_site->{$atom_id}{'origin_atom_id'};

                next if ! defined $origin_atom_id ||
                    ! exists $target_bond_length_site->{$origin_atom_id};

                $target_bond_length_site->{$atom_id} =
                    $bond_length_site->{$atom_id};
            }
        }

        stretchable_bonds( $parameters, $bond_length_site,
                           { 'include_mainchain' => $calc_mainchain,
                             'include_hetatoms' => $calc_hetatoms } );
        my $bond_lengths = collect_bond_lengths( $bond_length_site );

        my $bond_length_id = 1;
        for my $residue_unique_key ( sort keys %{ $bond_lengths } ) {
            for my $bond_name (
                sort keys %{ $bond_lengths->{$residue_unique_key} } ) {
                my @atom_ids = @{ $bond_lengths->{$residue_unique_key}
                                                 {$bond_name}{'atom_ids'} };

                my @site_ids = ();
                for my $atom_id ( @atom_ids ) {
                    my $origin_atom_id =
                        $bond_length_site->{$atom_id}{'origin_atom_id'};

                    if( ! defined $origin_atom_id) {
                        push @site_ids, '.';
                        next;
                    }

                    if( exists $atom_site->{$origin_atom_id}{'ligand_site_id'} ) {
                        push @site_ids,
                            $atom_site->{$origin_atom_id}{'ligand_site_id'};
                    } else {
                        push @site_ids, '.';
                    }
                }

                # The destinction between main-chain and side-chain dihedral
                # angles is that different from side-chain, main-chain dihedral
                # angles span multiple residues. So, it has to be dealt with.
                # HACK: for now, only 'alt_id' is checked.
                my $residue_atom_id =
                    scalar( uniq map { $bond_length_site->{$_}{'label_alt_id'} }
                                     @atom_ids ) > 1 ?
                    $atom_ids[1]:
                    $atom_ids[0];

                my ( $last_atom_id ) = reverse @atom_ids;

                next if ! defined $target_bond_length_site->{$last_atom_id};

                push @{ $pdbx->{'_[local]_bond_length'}{'data'} },
                    { 'id' => $bond_length_id,
                      'label_comp_id' =>
                          $bond_length_site->{$residue_atom_id}{'label_comp_id'},
                      'label_seq_id' =>
                          $bond_length_site->{$residue_atom_id}{'label_seq_id'},
                      'label_asym_id' =>
                          $bond_length_site->{$residue_atom_id}{'label_asym_id'},
                      'pdbx_PDB_model_num' =>
                          $bond_length_site->{$residue_atom_id}{'pdbx_PDB_model_num'},
                      'label_alt_id' =>
                          ( $calc_hetatoms &&
                            defined $bond_length_site->{$residue_atom_id}
                                                       {'origin_atom_id'} ) ?
                          $bond_length_site->{$bond_length_site->{$residue_atom_id}{'origin_atom_id'}}
                                             {'label_alt_id'} :
                          $bond_length_site->{$residue_atom_id}{'label_alt_id'},
                      'atom_1_id' =>
                          ( $calc_hetatoms &&
                            defined $bond_length_site->{$atom_ids[0]}{'origin_atom_id'} ) ?
                            $bond_length_site->{$atom_ids[0]}{'origin_atom_id'} :
                            $atom_ids[0],
                      'site_1_id' => $site_ids[0],
                      'label_atom_1_id' =>
                          $bond_length_site->{$atom_ids[0]}{'label_atom_id'},
                      'atom_2_id' =>
                          ( $calc_hetatoms &&
                            defined $bond_length_site->{$atom_ids[1]}{'origin_atom_id'} ) ?
                            $bond_length_site->{$atom_ids[1]}{'origin_atom_id'} :
                            $atom_ids[1],
                      'label_atom_2_id' =>
                          $bond_length_site->{$atom_ids[1]}{'label_atom_id'},
                      'site_2_id' => $site_ids[1],
                      'type' => $bond_lengths->{$residue_unique_key}{$bond_name}{'alt_name'},
                      'value' =>
                          sprintf $sig_figs_max,
                                  $bond_lengths->{$residue_unique_key}
                                                 {$bond_name}
                                                 {'value'} };
                $bond_length_id++;
            }
        }

    } else {
        $pdbx->{'_[local]_length'}{'metadata'}{'attributes'} =
            [ 'id', 'label_atom_1_id', 'atom_1_id', 'label_comp_1_id',
              'label_seq_1_id', 'label_asym_1_id', 'pdbx_PDB_model_num_1',
              'label_alt_1_id', 'site_1_id', 'label_atom_2_id', 'atom_2_id',
              'label_comp_2_id', 'label_seq_2_id', 'label_asym_2_id',
              'pdbx_PDB_model_num_2', 'label_alt_2_id', 'site_2_id', 'value' ];
        $pdbx->{'_[local]_length'}{'metadata'}{'is_loop'} = 1;
        $pdbx->{'_[local]_length'}{'metadata'}{'type'} = 'record';

        my $length_site =
            filter( { 'atom_site' => $atom_site,
                      'include' => { '[local]_selection_state' => [ 'T' ] },
                      'exclude' => { '[local]_selection_group' => [ q{?} ] } } );

        if( ! %{ $length_site } ) {
            warning( { 'program' => $0,
                       'message' => 'no atoms were selected for calculating ' .
                                    "bond lengths.\n" } );
            next;
        }

        my @length_atom_ids =
            sort { $length_site->{"$a"}{'[local]_selection_group'} <=>
                   $length_site->{"$b"}{'[local]_selection_group'} ||
                   $length_site->{"$a"}{'id'} <=>
                   $length_site->{"$b"}{'id'}  }
            keys %{ $length_site };

        my $length_id = 1;
        my %visited_comparisons = ();
        for( my $i = 0; $i <= $#length_atom_ids; $i++ ) {
            for( my $j = 0; $j <= $#length_atom_ids; $j++ ) {
                my $first_atom_id = $length_atom_ids[$i];
                my $second_atom_id = $length_atom_ids[$j];

                next if $first_atom_id == $second_atom_id;
                next if defined $visited_comparisons{$first_atom_id}{$second_atom_id};

                $visited_comparisons{$first_atom_id}{$second_atom_id} = 1;
                $visited_comparisons{$second_atom_id}{$first_atom_id} = 1;

                my @site_ids = ();
                for my $atom_id ( $first_atom_id, $second_atom_id ) {
                    my $origin_atom_id =
                        $length_site->{$atom_id}{'origin_atom_id'};

                    if( ! defined $origin_atom_id) {
                        push @site_ids, '.';
                        next;
                    }

                    if( exists $atom_site->{$origin_atom_id}{'ligand_site_id'} ) {
                        push @site_ids,
                            $atom_site->{$origin_atom_id}{'ligand_site_id'};
                    } else {
                        push @site_ids, '.';
                    }
                }

                my $length =
                    bond_length(
                        [ map { [ $length_site->{$_}{'Cartn_x'},
                                  $length_site->{$_}{'Cartn_y'},
                                  $length_site->{$_}{'Cartn_z'} ] }
                          ( $first_atom_id, $second_atom_id ) ] );

                push @{ $pdbx->{'_[local]_length'}{'data'} },
                      { 'id' => $length_id,
                        'label_atom_1_id' => $first_atom_id,
                        'atom_1_id' =>
                            $length_site->{$first_atom_id}{'label_atom_id'},
                        'label_comp_1_id' =>
                            $length_site->{$first_atom_id}{'label_comp_id'},
                        'label_seq_1_id' =>
                            $length_site->{$first_atom_id}{'label_seq_id'},
                        'label_asym_1_id' =>
                            $length_site->{$first_atom_id}{'label_asym_id'},
                        'pdbx_PDB_model_num_1' =>
                            $length_site->{$first_atom_id}{'pdbx_PDB_model_num'},
                        'label_alt_1_id' =>
                            $length_site->{$first_atom_id}{'label_alt_id'},
                        'site_1_id' => $site_ids[0],
                        'label_atom_2_id' => $second_atom_id,
                        'atom_2_id' =>
                            $length_site->{$second_atom_id}{'label_atom_id'},
                        'label_comp_2_id' =>
                            $length_site->{$second_atom_id}{'label_comp_id'},
                        'label_seq_2_id' =>
                            $length_site->{$second_atom_id}{'label_seq_id'},
                        'label_asym_2_id' =>
                            $length_site->{$second_atom_id}{'label_asym_id'},
                        'pdbx_PDB_model_num_2' =>
                            $length_site->{$second_atom_id}{'pdbx_PDB_model_num'},
                        'label_alt_2_id' =>
                            $length_site->{$second_atom_id}{'label_alt_id'},
                        'site_2_id' => $site_ids[1],
                        'value' =>
                            sprintf $sig_figs_max, $length };

                $length_id++;
            }
        }
    }

    if( $output_format eq 'pdbx' ) {
        to_pdbx( $pdbx, { 'tags' => [ '_[local]_bond_length',
                                      '_[local]_length' ] } );
    } elsif( $output_format eq 'csv' ) {
        if( $calc_sidechain ) {
            to_csv( $pdbx, { 'category' => '_[local]_bond_length' } );
        } else {
            to_csv( $pdbx, { 'category' => '_[local]_length' } );
        }
    } else {
        error(
            { 'program' => $0,
              'message' => "output format '${output_format}'" .
                           " is not supported.\n" } );
    }
}
