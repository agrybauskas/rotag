#!/usr/bin/perl

use strict;
use warnings;

use autodie;
use File::Basename;
use Getopt::Long;
use List::MoreUtils qw( uniq );
use Try::Tiny;

use BondParameters qw( bendable_angles
                       collect_bond_angles );
use Combinatorics qw( permutation );
use ConnectAtoms qw( assign_hetatoms
                     connect_atoms );
use ForceField::Parameters;
use Logging qw( error
                warning );
use Measure qw( bond_angle );
use PDBxParser qw( determine_ligand_sites
                   filter
                   mark_selection
                   obtain_pdbx_data
                   raw2indexed
                   to_csv
                   to_pdbx );
use Version qw( $VERSION );

Getopt::Long::Configure qw( gnu_getopt );

our $VERSION = $VERSION;

#*rotag_angle [options] [--] <cif-file>...
#*    calculates angles between selected atoms or bonds in residues.
#*
#*Usage:
#*    rotag_angle input.cif > output.cif
#*
#*Options:
#*    -S, --side-chains
#*                        calculates angles between bonds in the side-chain atoms.
#*    -M, --main-chains
#*                        calculates angles between bonds in the main-chain atoms.
#*    -H, --hetero-atoms
#*                        calculates pseudo bond angles for heteroatoms.
#*    -r, --radians
#*                        angles are in radians.
#*    -F, --format <format>
#*                        output format (default: pdbx | csv).
#*    -v, --version
#*                        print version.

# --------------------------------- Options ----------------------------------- #

my $calc_sidechain = 0;
my $calc_mainchain = 0;
my $calc_hetatoms = 0;
my $in_radians = 0;
my $output_format = 'pdbx';

local $SIG{__WARN__} = sub {
    warning( { 'program' => $0,
               'message' => @_,
               'filename' => join( ', ', @ARGV ) } );
};

local $SIG{__DIE__} = sub {
    error( { 'program' => $0,
             'message' => @_,
             'filename' => join( ', ', @ARGV ) } );
};

GetOptions(
    'side-chains|S' => sub { $calc_sidechain = 1 },
    'main-chains|M' => sub { $calc_mainchain = 1 },
    'hetero-atoms|H' => sub { $calc_hetatoms = 1 },
    'radians|r' => sub { $in_radians = 1 },
    'format|F=s' => \$output_format,
    'help|h' => sub {
                        open my $fh, '<', $0;
                        while( <$fh> ) {
                            my ( $help_message ) = $_ =~ m/^#(\*.*)/;
                            if( $help_message ) {
                                $help_message =~ s/^\*$/ /smgx;
                                $help_message =~ s/^\*//smgx;
                                print $help_message, "\n";
                            }
                        }
                        close $fh;
                        exit;
                    },
    'version|v' => sub { print $VERSION, "\n"; exit; }
) or error( { 'program' => $0,
              'message' => "mistake in command line argument.\n" } );

# ----------------------------------- Main ------------------------------------ #

local @ARGV = ( q{-} ) unless @ARGV;

my $parameters = Parameters->new();
my $pi = $parameters->{'_[local]_constants'}{'pi'};
my $sig_figs_min = $parameters->{'_[local]_constants'}{'sig_figs_min'};
my $sig_figs_max = $parameters->{'_[local]_constants'}{'sig_figs_max'};

for my $pdbx_file ( @ARGV ) {
    my $pdbx = obtain_pdbx_data( $pdbx_file, [ '_atom_site', '_struct_conn' ] );
    raw2indexed( $pdbx, { 'attributes' => { '_atom_site' => [ 'id' ],
                                            '_struct_conn' => [ 'id' ] } } );

    my $atom_site = $pdbx->{'_atom_site'}{'data'};
    my $struct_conn = $pdbx->{'_struct_conn'}{'data'};

    if( ! defined $atom_site ) {
        warning( { 'program' => $0,
                   'message' => "no atom sites were detected.\n" } );
        next;
    }

    determine_ligand_sites( $atom_site, $struct_conn );

    if( $calc_sidechain ) {
        $pdbx->{'_[local]_bond_angle'}{'metadata'}{'attributes'} =
            [ 'id', 'label_comp_id', 'label_seq_id', 'label_asym_id',
              'pdbx_PDB_model_num', 'label_alt_id', 'atom_1_id', 'site_1_id',
              'label_atom_1_id', 'atom_2_id', 'site_2_id', 'label_atom_2_id',
              'atom_3_id', 'site_3_id', 'label_atom_3_id', 'type', 'value',
              'units' ];
        $pdbx->{'_[local]_bond_angle'}{'metadata'}{'is_loop'} = 1;
        $pdbx->{'_[local]_bond_angle'}{'metadata'}{'type'} = 'record';

        my $bond_angle_site =
            filter( { 'atom_site' => $atom_site,
                      'include' => { '[local]_selection_state' => [ 'T', 'S' ] } } );
        my $target_bond_angle_site =
            filter( { 'atom_site' => $bond_angle_site,
                      'include' => { '[local]_selection_state' => [ 'T' ] } } );

        # Selects all atoms if no specific atoms are selected.
        if( ! %{ $bond_angle_site } ) {
            $bond_angle_site = $atom_site;
            $target_bond_angle_site = $atom_site;
            mark_selection( $bond_angle_site,
                            { 'target' => [ keys %{ $bond_angle_site } ] } );
        }

        connect_atoms( $parameters, $bond_angle_site );

        # Heteroatom assignment increases the atom number in the atom site.
        if( $calc_hetatoms ) {
            assign_hetatoms( $parameters, $bond_angle_site, $struct_conn );

            # Updating the target's atom site as there more duplicated pseudo
            # atoms.
            for my $atom_id ( keys %{ $bond_angle_site } ) {
                my $origin_atom_id =
                    $bond_angle_site->{$atom_id}{'origin_atom_id'};

                next if ! defined $origin_atom_id ||
                    ! exists $target_bond_angle_site->{$origin_atom_id};

                $target_bond_angle_site->{$atom_id} =
                    $bond_angle_site->{$atom_id};
            }
        }

        bendable_angles( $parameters, $bond_angle_site,
                         { 'include_mainchain' => $calc_mainchain,
                           'include_hetatoms' => $calc_hetatoms } );
        bendable_angles( $parameters, $bond_angle_site,
                         { 'include_mainchain' => $calc_mainchain,
                           'include_hetatoms' => $calc_hetatoms,
                           'start_atom_names' => [ 'CA' ] } ) if $calc_hetatoms;
        my $bond_angles = collect_bond_angles( $bond_angle_site );

        my $bond_angle_id = 1;
        for my $residue_unique_key ( sort keys %{ $bond_angles } ) {
            for my $angle_name (
                sort { $bond_angles->{$residue_unique_key}{$a}{'order'} <=>
                       $bond_angles->{$residue_unique_key}{$b}{'order'} ||
                       $a cmp $b }
                keys %{ $bond_angles->{$residue_unique_key} } ) {
                my @atom_ids = @{ $bond_angles->{$residue_unique_key}
                                                {$angle_name}{'atom_ids'} };

                my @site_ids = ();
                for my $atom_id ( @atom_ids ) {
                    my $origin_atom_id =
                        $bond_angle_site->{$atom_id}{'origin_atom_id'};

                    if( ! defined $origin_atom_id) {
                        push @site_ids, '.';
                        next;
                    }

                    if( exists $atom_site->{$origin_atom_id}{'ligand_site_id'} ) {
                        push @site_ids,
                            $atom_site->{$origin_atom_id}{'ligand_site_id'};
                    } else {
                        push @site_ids, '.';
                    }
                }

                # The destinction between main-chain and side-chain dihedral
                # angles is that different from side-chain, main-chain dihedral
                # angles span multiple residues. So, it has to be dealt with.
                # HACK: for now, only 'alt_id' is checked.
                my $residue_atom_id =
                    scalar( uniq map { $bond_angle_site->{$_}{'label_alt_id'} }
                                     @atom_ids ) > 1 ?
                    $atom_ids[2]:
                    $atom_ids[1];

                my ( $last_atom_id ) = reverse @atom_ids;

                next if ! defined $target_bond_angle_site->{$last_atom_id};

                push @{ $pdbx->{'_[local]_bond_angle'}{'data'} },
                    { 'id' => $bond_angle_id,
                      'label_comp_id' =>
                          $bond_angle_site->{$residue_atom_id}{'label_comp_id'},
                      'label_seq_id' =>
                          $bond_angle_site->{$residue_atom_id}{'label_seq_id'},
                      'label_asym_id' =>
                          $bond_angle_site->{$residue_atom_id}{'label_asym_id'},
                      'pdbx_PDB_model_num' =>
                          $bond_angle_site->{$residue_atom_id}{'pdbx_PDB_model_num'},
                      'label_alt_id' =>
                          ( $calc_hetatoms &&
                            defined $bond_angle_site->{$residue_atom_id}
                                                      {'origin_atom_id'} ) ?
                          $bond_angle_site->{$bond_angle_site->{$residue_atom_id}{'origin_atom_id'}}
                                            {'label_alt_id'} :
                          $bond_angle_site->{$residue_atom_id}{'label_alt_id'},
                      'atom_1_id' =>
                          ( $calc_hetatoms &&
                            defined $bond_angle_site->{$atom_ids[0]}{'origin_atom_id'} ) ?
                          $bond_angle_site->{$atom_ids[0]}{'origin_atom_id'} :
                          $atom_ids[0],
                      'site_1_id' => $site_ids[0],
                      'label_atom_1_id' =>
                          $bond_angle_site->{$atom_ids[0]}{'label_atom_id'},
                      'atom_2_id' =>
                          ( $calc_hetatoms &&
                            defined $bond_angle_site->{$atom_ids[1]}{'origin_atom_id'} ) ?
                          $bond_angle_site->{$atom_ids[1]}{'origin_atom_id'} :
                          $atom_ids[1],
                      'site_2_id' => $site_ids[1],
                      'label_atom_2_id' =>
                          $bond_angle_site->{$atom_ids[1]}{'label_atom_id'},
                      'atom_3_id' =>
                          ( $calc_hetatoms &&
                            defined $bond_angle_site->{$atom_ids[2]}{'origin_atom_id'} ) ?
                          $bond_angle_site->{$atom_ids[2]}{'origin_atom_id'} :
                          $atom_ids[2],
                      'site_3_id' => $site_ids[2],
                      'label_atom_3_id' =>
                          $bond_angle_site->{$atom_ids[2]}{'label_atom_id'},
                      'type' => $bond_angles->{$residue_unique_key}{$angle_name}{'alt_name'},
                      'value' => ( $in_radians ?
                                   sprintf $sig_figs_max,
                                           $bond_angles->{$residue_unique_key}
                                                         {$angle_name}
                                                         {'value'} :
                                   sprintf $sig_figs_min,
                                           $bond_angles->{$residue_unique_key}
                                                         {$angle_name}
                                                         {'value'} * 180 / $pi ),
                      'units' => ( $in_radians ? 'radians': 'degrees' ) };
                $bond_angle_id++;
            }
        }

    } else {
        $pdbx->{'_[local]_angle'}{'metadata'}{'attributes'} =
            [ 'id', 'label_atom_1_id', 'atom_1_id', 'label_comp_1_id',
              'label_seq_1_id', 'label_asym_1_id', 'pdbx_PDB_model_num_1',
              'label_alt_1_id', 'label_atom_2_id', 'atom_2_id', 'label_comp_2_id',
              'label_seq_2_id', 'label_asym_2_id', 'pdbx_PDB_model_num_2',
              'label_alt_2_id', 'label_atom_3_id', 'atom_3_id', 'label_comp_3_id',
              'label_seq_3_id', 'label_asym_3_id', 'pdbx_PDB_model_num_3',
              'label_alt_3_id', 'value', 'units' ];
        $pdbx->{'_[local]_angle'}{'metadata'}{'is_loop'} = 1;
        $pdbx->{'_[local]_angle'}{'metadata'}{'type'} = 'record';

        my $angle_site =
            filter( { 'atom_site' => $atom_site,
                      'include' => { '[local]_selection_state' => [ 'T' ] },
                      'exclude' => { '[local]_selection_group' => [ q{?} ] } } );

        if( ! %{ $angle_site } ) {
            warning( { 'program' => $0,
                       'message' => 'no atoms were selected for calculating ' .
                                    "bond angles.\n" } );
            next;
        }

        my @angle_atom_ids =
            sort { $angle_site->{"$a"}{'[local]_selection_group'} <=>
                   $angle_site->{"$b"}{'[local]_selection_group'} ||
                   $angle_site->{"$a"}{'id'} <=>
                   $angle_site->{"$b"}{'id'}  }
            keys %{ $angle_site };

        my $angle_id = 1;
        my $angle_atom_ids_comb =
            permutation( 3, [], [ map { \@angle_atom_ids } 0..2 ], [] );
        my %visited_comparisons = ();
        for my $angle_atom_ids ( @{ $angle_atom_ids_comb } ) {
            my $first_atom_id = $angle_atom_ids->[0];
            my $second_atom_id = $angle_atom_ids->[1];
            my $third_atom_id = $angle_atom_ids->[2];

            next if $first_atom_id == $second_atom_id ||
                    $first_atom_id == $third_atom_id ||
                    $second_atom_id == $third_atom_id;
            next if defined $visited_comparisons{$first_atom_id}{$second_atom_id}{$third_atom_id};

            $visited_comparisons{$first_atom_id}{$second_atom_id}{$third_atom_id} = 1;
            $visited_comparisons{$third_atom_id}{$second_atom_id}{$first_atom_id} = 1;

            my @site_ids = ();
            for my $atom_id ( $first_atom_id, $second_atom_id, $third_atom_id ) {
                my $origin_atom_id = $angle_site->{$atom_id}{'origin_atom_id'};

                if( ! defined $origin_atom_id) {
                    push @site_ids, '.';
                    next;
                }

                if( exists $atom_site->{$origin_atom_id}{'ligand_site_id'} ) {
                    push @site_ids,
                        $atom_site->{$origin_atom_id}{'ligand_site_id'};
                } else {
                    push @site_ids, '.';
                }
            }

            my $angle =
                bond_angle(
                    [ map { [ $angle_site->{$_}{'Cartn_x'},
                              $angle_site->{$_}{'Cartn_y'},
                              $angle_site->{$_}{'Cartn_z'} ] }
                      ( $first_atom_id, $second_atom_id, $third_atom_id ) ] );

            push @{ $pdbx->{'_[local]_angle'}{'data'} },
                  { 'id' => $angle_id,
                    'label_atom_1_id' => $first_atom_id,
                    'atom_1_id' =>
                        $angle_site->{$first_atom_id}{'label_atom_id'},
                    'label_comp_1_id' =>
                        $angle_site->{$first_atom_id}{'label_comp_id'},
                    'label_seq_1_id' =>
                        $angle_site->{$first_atom_id}{'label_seq_id'},
                    'label_asym_1_id' =>
                        $angle_site->{$first_atom_id}{'label_asym_id'},
                    'pdbx_PDB_model_num_1' =>
                        $angle_site->{$first_atom_id}{'pdbx_PDB_model_num'},
                    'label_alt_1_id' =>
                        $angle_site->{$first_atom_id}{'label_alt_id'},
                    'site_1_id' => $site_ids[0],
                    'label_atom_2_id' => $second_atom_id,
                    'atom_2_id' =>
                        $angle_site->{$second_atom_id}{'label_atom_id'},
                    'label_comp_2_id' =>
                        $angle_site->{$second_atom_id}{'label_comp_id'},
                    'label_seq_2_id' =>
                        $angle_site->{$second_atom_id}{'label_seq_id'},
                    'label_asym_2_id' =>
                        $angle_site->{$second_atom_id}{'label_asym_id'},
                    'pdbx_PDB_model_num_2' =>
                        $angle_site->{$second_atom_id}{'pdbx_PDB_model_num'},
                    'label_alt_2_id' =>
                        $angle_site->{$second_atom_id}{'label_alt_id'},
                    'site_2_id' => $site_ids[1],
                    'label_atom_3_id' => $third_atom_id,
                    'atom_3_id' =>
                        $angle_site->{$third_atom_id}{'label_atom_id'},
                    'label_comp_3_id' =>
                        $angle_site->{$third_atom_id}{'label_comp_id'},
                    'label_seq_3_id' =>
                        $angle_site->{$third_atom_id}{'label_seq_id'},
                    'label_asym_3_id' =>
                        $angle_site->{$third_atom_id}{'label_asym_id'},
                    'pdbx_PDB_model_num_3' =>
                        $angle_site->{$third_atom_id}{'pdbx_PDB_model_num'},
                    'label_alt_3_id' =>
                        $angle_site->{$third_atom_id}{'label_alt_id'},
                    'site_3_id' => $site_ids[2],
                    'value' => ( $in_radians ?
                                 sprintf $sig_figs_max, $angle :
                                 sprintf $sig_figs_min, 180 * $angle / $pi ),
                    'units' => ( $in_radians ? 'radians': 'degrees' ) };

            $angle_id++;
        }
    }

    if( $output_format eq 'pdbx' ) {
        to_pdbx( $pdbx, { 'tags' => [ '_[local]_bond_angle',
                                      '_[local]_angle' ] } );
    } elsif( $output_format eq 'csv' ) {
        if( $calc_sidechain ) {
            to_csv( $pdbx, { 'category' => '_[local]_bond_angle' } );
        } else {
            to_csv( $pdbx, { 'category' => '_[local]_angle' } );
        }
    } else {
        error(
            { 'program' => $0,
              'message' => "output format '${output_format}'" .
                           " is not supported.\n" } );
    }
}
